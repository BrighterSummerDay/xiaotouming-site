---
import { languages, type Lang } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navHome = `/${lang}`;
const navBlog = lang === 'zh' ? '/blog' : `/${lang}/blog`;
---

<header class="site-header">
  <div class="container bar">
    <a href={navHome} class="mono brand">$ xiaotouming<span class="brand-suffix">.site</span></a>

    <nav class="links">
      <a href={navHome}>{t('nav.work')}</a>
      <a href={navBlog}>{t('nav.blog')}</a>
    </nav>

    <div class="lang-switch mono">
      {Object.keys(languages).map((code) => (
        <a
          href={getLocalizedPath(currentPath, lang, code as Lang)}
          class:list={['lang-link', { active: code === lang }]}
        >
          {code}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
    background: rgba(237, 239, 243, 0.85);
    border-bottom: 1px solid var(--color-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .brand {
    font-weight: 600;
    color: var(--color-ink);
  }
  .brand-suffix {
    color: var(--color-accent);
  }
  .links {
    display: flex;
    gap: var(--space-3);
  }
  .links a {
    font-size: 0.95rem;
    color: var(--color-muted);
  }
  .links a:hover {
    color: var(--color-ink);
  }
  .lang-switch {
    display: flex;
    gap: 0.4rem;
    font-size: 0.8rem;
  }
  .lang-link {
    padding: 0.2rem 0.5rem;
    border-radius: 5px;
    color: var(--color-muted);
  }
  .lang-link.active {
    background: var(--color-accent);
    color: #fff;
  }
</style>
