---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslations } from '../../i18n/utils';
import { projects } from '../../data/projects';
import ScrollHint from '../../components/ScrollHint.astro';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<Layout lang={lang} title="Xiaotouming">
  <Hero lang={lang} />

  <section id="work" class="container work-section">
    <h2 data-reveal>{t('work.title')}</h2>
    <p data-reveal>{t('work.subtitle')}</p>
    <div class="grid">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>
  <ScrollHint endText="── That is all. ──" />
</Layout>

<style>
  .work-section {
    padding-top: var(--space-3);
    padding-bottom: var(--space-5);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .work-section {
      padding-top: var(--space-2);
      padding-bottom: var(--space-4);
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: var(--space-3);
    }
  }
</style>
