---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => id.startsWith('ja/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace('ja/', '').replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const lang = 'ja' as const;
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${post.data.title} · Xiaotouming`} description={post.data.description}>
  <article class="container post">
    <a href="/ja/blog" class="mono back-link" data-reveal>{t('blog.back')}</a>
    <p class="mono post-date" data-reveal>{post.data.pubDate.toISOString().slice(0, 10)}</p>
    <h1 data-reveal>{post.data.title}</h1>
    <div class="prose" data-reveal>
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post { padding-top: var(--space-5); padding-bottom: var(--space-5); max-width: 42rem; }
  .back-link {
    color: var(--color-accent);
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0.2rem 0;
    touch-action: manipulation;
  }
  .back-link:hover { color: var(--color-ink); }
  .post-date { color: var(--color-muted); margin-top: var(--space-3); }
  .prose { margin-top: var(--space-3); line-height: 1.8; }
  .prose :global(p) { color: var(--color-ink); }

  @media (max-width: 640px) {
    .post {
      padding-top: var(--space-3);
      padding-bottom: var(--space-5);
    }
    .post-date {
      margin-top: var(--space-2);
      font-size: 0.8rem;
    }
    .post h1 {
      font-size: clamp(1.6rem, 6.5vw, 2.1rem);
      line-height: 1.25;
      margin-top: 0.2rem;
    }
    .prose {
      margin-top: var(--space-2);
      line-height: 1.75;
      font-size: 0.96rem;
    }
  }
</style>
