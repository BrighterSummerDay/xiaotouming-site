---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import WarpedGrid from '../components/WarpedGrid.astro';

const welcomeData = [
  {
    lang: 'zh',
    code: 'ZH',
    label: '中文',
    greeting: '你好',
    title: '欢迎来到小透铭的个人网站',
    subtitle: '开发日记 · 项目展示 · 个人博客',
    href: '/zh',
    desc: '探索中文项目展示、博客记录与关于页面',
  },
  {
    lang: 'ja',
    code: 'JA',
    label: '日本語',
    greeting: 'こんにちは',
    title: '小透銘のウェブサイトへようこそ',
    subtitle: '開発ログ · プロジェクト紹介 · 個人ブログ',
    href: '/ja',
    desc: '日本語のプロジェクト展示とブログ記事を見る',
  },
  {
    lang: 'en',
    code: 'EN',
    label: 'English',
    greeting: 'Hello',
    title: "Welcome to Xiaotouming's Website",
    subtitle: 'Building · Learning · Sharing',
    href: '/en',
    desc: 'Explore projects, blog posts, and about me in English',
  },
];
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>xiaotouming · 欢迎访问 | Portal</title>
    <meta name="description" content="小透铭的个人网站导航入口 - 请选择语言进入" />

    <!-- 字体加载 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body class="portal-body">
    <WarpedGrid mode="fixed" />

    <!-- 1. 脱离任何父容器的顶级全局 Logo（纯 CSS 保证从网页加载第 0 毫秒即居中常亮置顶） -->
    <div id="brand-logo" class="mono brand-logo">$ xiaotouming<span>.site</span></div>

    <!-- 2. 纸白极简开场幕布 (z-index: 9999) -->
    <div id="portal-curtain" class="portal-curtain">
      <div class="curtain-box mono">
        <div class="curtain-logo-placeholder"></div>
        <div id="curtain-bar-wrap" class="curtain-bar-wrap">
          <div class="curtain-bar">
            <div id="curtain-progress" class="curtain-progress"></div>
          </div>
          <span class="curtain-sub">INITIALIZING PORTAL</span>
        </div>
      </div>
    </div>

    <!-- 3. 背景渐变与微动效 -->
    <div class="portal-bg-decor">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
    </div>

    <!-- 4. 页面主体结构 -->
    <main class="portal-container">
      <header class="portal-header">
        <!-- Logo 目标归位占位节点 -->
        <div id="brand-logo-target" class="brand-logo-target"></div>
      </header>

      <!-- 动态三语欢迎动效区 -->
      <section class="welcome-hero">
        <h1 id="welcome-title" class="welcome-title">
          {welcomeData[0].title}
        </h1>

        <p id="welcome-subtitle" class="welcome-subtitle">
          {welcomeData[0].subtitle}
        </p>
      </section>

      <!-- 语言选择卡片区 -->
      <section id="lang-selection" class="lang-selection">
        <p class="mono selection-hint">
          请选择语言 / 言語を選択してください / SELECT LANGUAGE
        </p>

        <!-- 卡片展示区：桌面端三列网格，移动端 iOS 单卡平滑滑动轮播 -->
        <div id="cards-slider-container" class="cards-slider-container">
          <div id="cards-track" class="cards-track">
            {welcomeData.map((item, index) => (
              <a
                href={item.href}
                class:list={['lang-card', { 'is-active': index === 0 }]}
                data-index={index}
                data-lang={item.lang}
              >
                <div class="card-top">
                  <span class="mono card-code">{item.code}</span>
                </div>
                <div class="card-body">
                  <h2 class="card-label">{item.label}</h2>
                  <p class="card-greeting mono">{item.greeting} →</p>
                  <p class="card-desc">{item.desc}</p>
                </div>
                <div class="card-enter-btn mono">
                  <span>ENTER</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- 移动端专属：iOS 风格滑动指示小圆点/胶囊 -->
        <div class="slider-dots" id="slider-dots" aria-label="卡片切换指示器">
          {welcomeData.map((item, index) => (
            <button
              class:list={['dot', { 'is-active': index === 0 }]}
              data-slide={index}
              aria-label={`切换到 ${item.label}`}
            ></button>
          ))}
        </div>
      </section>

      <footer id="portal-footer" class="portal-footer mono">
        <span>© 2026 xiaotouming</span>
        <span>Built with Astro & GSAP</span>
      </footer>
    </main>

    <script>
      import { gsap } from 'gsap';

      const welcomeData = [
        {
          title: '欢迎来到小透铭的个人网站',
          subtitle: '开发日记 · 项目展示 · 个人博客',
        },
        {
          title: '小透銘のウェブサイトへようこそ',
          subtitle: '開発ログ · プロジェクト紹介 · 個人ブログ',
        },
        {
          title: "Welcome to Xiaotouming's Website",
          subtitle: 'Building · Learning · Sharing',
        },
      ];

      let currentIndex = 0;
      let timer: number | undefined;

      function initPortal() {
        if (timer) clearInterval(timer);
        currentIndex = 0;

        const brandLogo = document.getElementById('brand-logo');
        const targetPlaceholder = document.getElementById('brand-logo-target');
        const curtainEl = document.getElementById('portal-curtain');
        const progressEl = document.getElementById('curtain-progress');
        const barWrap = document.getElementById('curtain-bar-wrap');
        const welcomeHero = document.querySelector('.welcome-hero');
        const titleEl = document.getElementById('welcome-title');
        const subtitleEl = document.getElementById('welcome-subtitle');
        const langSelection = document.getElementById('lang-selection');
        const footerEl = document.getElementById('portal-footer');
        const cards = document.querySelectorAll('.lang-card');
        const cardsTrack = document.getElementById('cards-track');
        const sliderContainer = document.getElementById('cards-slider-container');
        const dots = document.querySelectorAll('#slider-dots .dot');

        if (!cards.length) return;

        function updateWelcome(index: number, isManual = false) {
          if (index === currentIndex && !isManual) return;
          currentIndex = index;

          cards.forEach((c, i) => {
            c.classList.toggle('is-active', i === index);
          });

          // 移动端卡片平滑滚动至对应卡片（营造三卡片水平滑行质感）
          if (cardsTrack && window.innerWidth <= 768) {
            cardsTrack.style.setProperty('transform', `translateX(-${index * 100}%)`, 'important');
          }

          // 同步更新 iOS 风格胶囊指示点
          dots.forEach((dot, i) => {
            dot.classList.toggle('is-active', i === index);
          });

          // 欢迎语平滑渐变动效
          gsap.timeline()
            .to([titleEl, subtitleEl], {
              opacity: 0,
              y: -10,
              filter: 'blur(8px)',
              duration: 0.28,
              stagger: 0.04,
              ease: 'power2.in',
              onComplete: () => {
                if (titleEl) titleEl.textContent = welcomeData[index].title;
                if (subtitleEl) subtitleEl.textContent = welcomeData[index].subtitle;
              },
            })
            .fromTo(
              [titleEl, subtitleEl],
              { opacity: 0, y: 12, filter: 'blur(8px)' },
              {
                opacity: 1,
                y: 0,
                filter: 'blur(0px)',
                duration: 0.5,
                stagger: 0.06,
                ease: 'power2.out',
              }
            );
        }

        function startAutoRotate() {
          if (timer) clearInterval(timer);
          timer = window.setInterval(() => {
            const nextIdx = (currentIndex + 1) % welcomeData.length;
            updateWelcome(nextIdx);
          }, 3800);
        }

        // 桌面端鼠标悬浮触发切换
        cards.forEach((card, idx) => {
          card.addEventListener('mouseenter', () => {
            if (window.innerWidth > 768) {
              if (timer) clearInterval(timer);
              updateWelcome(idx, true);
            }
          });

          card.addEventListener('mouseleave', () => {
            if (window.innerWidth > 768) {
              startAutoRotate();
            }
          });
        });

        // 移动端 iOS 胶囊指示小圆点点击直达
        dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            const slideIdx = parseInt(dot.getAttribute('data-slide') || '0', 10);
            if (timer) clearInterval(timer);
            updateWelcome(slideIdx, true);
            startAutoRotate();
          });
        });

        // 移动端手势滑动支持（Swipe Left / Right）及卡片轻触跳转保护
        if (sliderContainer) {
          let touchStartX = 0;
          let touchStartY = 0;
          let isSwiping = false;

          sliderContainer.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
            isSwiping = false;
            if (timer) clearInterval(timer);
          }, { passive: true });

          sliderContainer.addEventListener('touchmove', (e) => {
            const diffX = Math.abs(e.changedTouches[0].screenX - touchStartX);
            const diffY = Math.abs(e.changedTouches[0].screenY - touchStartY);
            if (diffX > 10 && diffX > diffY) {
              isSwiping = true;
            }
          }, { passive: true });

          sliderContainer.addEventListener('touchend', (e) => {
            const touchEndX = e.changedTouches[0].screenX;
            const touchEndY = e.changedTouches[0].screenY;
            const diffX = touchStartX - touchEndX;
            const diffY = touchStartY - touchEndY;
            if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
              if (diffX > 0) {
                // 向左滑 -> 下一张
                const nextIdx = (currentIndex + 1) % welcomeData.length;
                updateWelcome(nextIdx, true);
              } else {
                // 向右滑 -> 上一张
                const prevIdx = (currentIndex - 1 + welcomeData.length) % welcomeData.length;
                updateWelcome(prevIdx, true);
              }
            }
            setTimeout(() => {
              isSwiping = false;
            }, 60);
            startAutoRotate();
          }, { passive: true });

          cards.forEach((card) => {
            card.addEventListener('touchstart', () => {
              card.classList.add('is-touched');
            }, { passive: true });

            card.addEventListener('touchend', () => {
              card.classList.remove('is-touched');
            }, { passive: true });

            card.addEventListener('touchcancel', () => {
              card.classList.remove('is-touched');
            }, { passive: true });

            card.addEventListener('click', (e) => {
              if (isSwiping) {
                e.preventDefault();
              }
            });
          });
        }

        // 窗口尺寸变化响应
        window.addEventListener('resize', () => {
          if (cardsTrack) {
            if (window.innerWidth > 768) {
              cardsTrack.style.removeProperty('transform');
            } else {
              cardsTrack.style.setProperty('transform', `translateX(-${currentIndex * 100}%)`, 'important');
            }
          }
        });

        // 开场动效：彻底消除 Transform 叠加，像素级绝对对齐
        if (brandLogo && targetPlaceholder && curtainEl && progressEl && barWrap) {
          try {
            if (brandLogo.parentElement !== document.body) {
              document.body.appendChild(brandLogo);
            }

            // 页面主体预先隐藏并置上
            gsap.set([welcomeHero, langSelection, footerEl], {
              opacity: 0,
              y: -20,
            });

            langSelection?.setAttribute('inert', '');

            const isNarrow = window.innerWidth < 480;

            // 初始绝对居中状态：由 CSS left:0; right:0; margin: 0 auto 原生保障，消除任何 transform 叠加偏移
            gsap.set(brandLogo, {
              position: 'fixed',
              top: 'calc(50vh - 36px)',
              left: 0,
              right: 0,
              marginLeft: 'auto',
              marginRight: 'auto',
              width: 'max-content',
              fontSize: isNarrow ? '1.18rem' : '1.5rem',
              whiteSpace: 'nowrap',
              opacity: 1,
              pointerEvents: 'none',
              clearProps: 'transform',
            });

            const tl = gsap.timeline({
              onComplete: () => {
                langSelection?.removeAttribute('inert');

                // 归位到 Header 占位节点
                targetPlaceholder.appendChild(brandLogo);
                gsap.set(brandLogo, {
                  position: 'static',
                  top: 'auto',
                  left: 'auto',
                  right: 'auto',
                  margin: 0,
                  fontSize: isNarrow ? '1.05rem' : '1.25rem',
                  clearProps: 'transform',
                  whiteSpace: 'nowrap',
                  pointerEvents: 'auto',
                });

                startAutoRotate();
              },
            });

            // 步骤 1: 进度条读条 (1.0s)
            tl.to(progressEl, {
              width: '100%',
              duration: 1.0,
              ease: 'power2.inOut',
            })
            // 步骤 2: 进度条淡出 (0.35s)
            .to(barWrap, {
              opacity: 0,
              y: 12,
              duration: 0.35,
              ease: 'power2.in',
            }, '+=0.1')
            // 步骤 3: 飞行前将居中坐标无缝定格为绝对 left/top，平滑飞到 Header target 坐标
            .call(() => {
              const currentRect = brandLogo.getBoundingClientRect();
              gsap.set(brandLogo, {
                left: `${currentRect.left}px`,
                top: `${currentRect.top}px`,
                right: 'auto',
                marginLeft: 0,
                marginRight: 0,
              });
            })
            .to(brandLogo, {
              top: () => `${targetPlaceholder.getBoundingClientRect().top}px`,
              left: () => `${targetPlaceholder.getBoundingClientRect().left}px`,
              fontSize: isNarrow ? '1.05rem' : '1.25rem',
              duration: 1.1,
              ease: 'power3.inOut',
            })
            // 幕布同步淡隐
            .to(curtainEl, {
              opacity: 0,
              duration: 0.9,
              ease: 'power2.out',
              onComplete: () => {
                curtainEl.style.display = 'none';
              },
            }, '-=0.9')
            // 步骤 4: 页面主体顺次展开
            .to(welcomeHero, {
              opacity: 1,
              y: 0,
              duration: 1.1,
              ease: 'power2.out',
            }, '-=0.2')
            .to(langSelection, {
              opacity: 1,
              y: 0,
              duration: 1.3,
              ease: 'power2.out',
            }, '-=0.7')
            .to(footerEl, {
              opacity: 1,
              y: 0,
              duration: 1.0,
              ease: 'power2.out',
            }, '-=0.7');
          } catch (err) {
            console.error('Portal animation error, falling back:', err);
            if (curtainEl) curtainEl.style.display = 'none';
            if (brandLogo && targetPlaceholder && brandLogo.parentElement !== targetPlaceholder) {
              targetPlaceholder.appendChild(brandLogo);
              gsap.set(brandLogo, {
                position: 'static',
                top: 'auto',
                left: 'auto',
                right: 'auto',
                margin: 0,
                clearProps: 'transform',
                whiteSpace: 'nowrap',
                pointerEvents: 'auto',
              });
            }
            gsap.set([welcomeHero, langSelection, footerEl], { opacity: 1, y: 0 });
            langSelection?.removeAttribute('inert');
            startAutoRotate();
          }
        } else {
          if (brandLogo && targetPlaceholder && brandLogo.parentElement !== targetPlaceholder) {
            targetPlaceholder.appendChild(brandLogo);
            gsap.set(brandLogo, {
              position: 'static',
              top: 'auto',
              left: 'auto',
              xPercent: 0,
              yPercent: 0,
              transform: 'none',
              pointerEvents: 'auto',
            });
          }
          // 兜底全显并启动轮播
          gsap.set([welcomeHero, langSelection, footerEl], { opacity: 1, y: 0 });
          startAutoRotate();
        }
      }

      // 支持 View Transitions
      document.addEventListener('astro:page-load', initPortal);
    </script>
  </body>
</html>

<style>
  .portal-body {
    margin: 0;
    min-height: 100vh;
    background: var(--page-gradient-1), var(--page-gradient-2), var(--color-bg);
    color: var(--color-ink);
    font-family: var(--font-body);
    display: flex;
    isolation: isolate;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow-x: hidden;
  }

  /* 顶级全局 Logo 样式 (最高 z-index，突破任何层级覆盖) */
  #brand-logo {
    position: fixed;
    z-index: 10001;
    font-size: clamp(1.15rem, 5vw, 1.5rem);
    font-weight: 700;
    color: var(--color-ink);
    top: calc(50vh - 36px);
    left: 0;
    right: 0;
    margin: 0 auto;
    width: max-content;
    line-height: 1.8rem;
    white-space: nowrap !important;
    pointer-events: none;
  }
  #brand-logo span {
    color: var(--color-accent);
  }

  /* 纸白极简开场幕布 (z-index: 9999) */
  .portal-curtain {
    position: fixed;
    inset: 0;
    background:
      var(--page-gradient-1),
      var(--page-gradient-2),
      var(--color-bg);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  .portal-curtain::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.4;
  }

  .curtain-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .curtain-logo-placeholder {
    font-size: clamp(1.15rem, 5vw, 1.5rem);
    height: 1.8rem;
    white-space: nowrap;
  }

  .curtain-bar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .curtain-bar {
    width: 180px;
    height: 4px;
    background: var(--color-line);
    border-radius: 999px;
    overflow: hidden;
  }

  .curtain-progress {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, var(--color-accent), var(--color-signal));
    border-radius: 999px;
  }

  .curtain-sub {
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.12em;
  }

  /* 背景浮动光晕 */
  .portal-bg-decor {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.25;
    animation: floatOrb 14s infinite alternate ease-in-out;
  }
  .orb-1 {
    width: 420px;
    height: 420px;
    background: var(--color-accent);
    top: 10%;
    left: 15%;
  }
  .orb-2 {
    width: 450px;
    height: 450px;
    background: var(--color-signal);
    bottom: 10%;
    right: 15%;
    animation-delay: -7s;
  }

  @keyframes floatOrb {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(45px, 35px) scale(1.12); }
  }

  .portal-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 980px;
    padding: var(--space-4) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .portal-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .brand-logo-target {
    height: 1.5rem;
    min-width: 180px;
    width: max-content;
    white-space: nowrap;
    display: flex;
    align-items: center;
  }

  /* Welcome Hero 动效展示 */
  .welcome-hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    min-height: 180px;
    justify-content: center;
  }

  .welcome-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.8vw, 3.4rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .welcome-subtitle {
    font-size: clamp(1.05rem, 2.1vw, 1.3rem);
    color: var(--color-muted);
    margin: 0;
    max-width: 650px;
  }

  /* 语言选择卡片网络 */
  .lang-selection {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .selection-hint {
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    margin: 0;
  }

  /* 桌面端：三卡片网格并排展示 */
  @media (min-width: 769px) {
    .cards-slider-container {
      width: 100%;
      overflow: visible;
      position: relative;
    }

    .cards-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3);
      width: 100%;
      transform: none !important;
    }

    /* iOS 风格小圆点：桌面端隐藏 */
    .slider-dots {
      display: none;
    }
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
    background: #ffffff;
    border: 1.5px solid var(--color-line);
    border-radius: calc(var(--radius) + 4px);
    padding: var(--space-3);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.35s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
